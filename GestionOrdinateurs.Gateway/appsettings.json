{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "MetadataAddress": "http://keycloak:8080/realms/MyRealm/.well-known/openid-configuration",
    "ValidIssuer": "http://localhost:8180/realms/MyRealm"
  },
  "Kestrel": {
        "Endpoints": {
            "http":{
                "Url": "http://0.0.0.0:5010"
            }
        }
    },
  "ReverseProxy": {
    "Routes": {
      "computerRoute": {
        "ClusterId": "computerManagementAPI",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/Computer/{**catch-all}"
        }
      },
      "repairRoute": {
        "ClusterId": "computerManagementAPI",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/Repair/{**catch-all}"
        }
      },
      "authenticationRoute": {
        "ClusterId": "authentificationAPI",
        "Match": {
          "Path": "/api/Authentication/{**catch-all}"
        }
      },
      "keycloakAuthRoute": {
        "ClusterId": "authentificationAPI",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "computerManagementAPI": {
        "Destinations": {
          "computerManagementService": {
            "Address": "http://computermanagement-api:5176/"
          }
        }
      },
      "authentificationAPI": {
        "Destinations": {
          "authentificationService": {
            "Address": "http://authentification-api:5150/"
          }
        }
      }
    }
  }
}
