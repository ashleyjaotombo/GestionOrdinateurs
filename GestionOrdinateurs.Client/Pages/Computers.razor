@page "/computers"

<PageTitle>Computers</PageTitle>

<h1>Liste des ordinateurs</h1>

@if (computers == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prix</th>
                <th>Devise</th>
                <th>Vendu</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var computer in computers)
            {
                <tr>
                    <td>@computer.Name</td>
                    <td>@computer.Price</td>
                    <td>€</td>
                    <td>@(computer.Sold ? "Oui" : "Non")</td>
                </tr>
            }
        </tbody>
    </table>
}
