    // Login via Keycloak
    private async Task SaveToken()
    {
        var client = Factory.CreateClient("HttpClientName");
        var response = await client.PostAsJsonAsync("Auth/login", new { username = Username, password = Password });

        if (!response.IsSuccessStatusCode)
        {
            Message = "Utilisateur ou mot de passe incorrect";
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<KeycloakTokenResponse>();
        var token = result?.access_token ?? "";

        // save token in session
        await SessionStorage.SetItemAsync("jwtToken", token);
        AuthProvider.NotifyUserAuthentication(token);
        Navigation.NavigateTo("/");
    }

    private record KeycloakTokenResponse(string access_token, int expires_in, string refresh_token);
}
